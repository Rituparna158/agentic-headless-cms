{
  "name": "worker",
  "version": "0.0.0",
  "description": "Background Queue Worker application",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "retry-failed": "tsx --env-file=../../.env src/scripts/retry-failed.ts",
    "benchmark": "tsx --env-file=../../.env src/scripts/benchmark-webhooks.ts",
    "send-live": "tsx --env-file=../../.env src/scripts/send-test-webhook.ts",
    "check-types": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@repo/config": "workspace:*",
    "@repo/logger": "workspace:*",
    "@repo/repository": "workspace:*",
    "@repo/storage": "workspace:*",
    "bullmq": "^5.80.5"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/node": "^24.0.0",
    "tsx": "^4.23.0",
    "typescript": "5.9.2",
    "vitest": "^4.1.10"
  }
}
