{
  "name": "@mindfiredigital/sdk-react",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "author": "Mindfire Digital",
  "repository": {
    "type": "git",
    "url": "https://github.com/mindfiredigital/agentic-headless-cms.git",
    "directory": "packages/sdk-react"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist",
    "check-types": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "peerDependencies": {
    "@mindfiredigital/sdk-core": "*",
    "@tanstack/react-query": "^5.0.0",
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@mindfiredigital/sdk-core": "workspace:*",
    "@repo/eslint-config": "workspace:*",
    "@repo/types": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@tanstack/react-query": "^5.28.4",
    "@testing-library/react": "^14.2.1",
    "@types/react": "^18.2.65",
    "jsdom": "^24.0.0",
    "msw": "^2.2.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsup": "^8.0.2",
    "typescript": "^5.3.3",
    "vitest": "^2.1.9"
  }
}
