{
  "name": "@mindfiredigital/sdk-node",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "author": "Mindfire Digital",
  "repository": {
    "type": "git",
    "url": "https://github.com/mindfiredigital/agentic-headless-cms.git",
    "directory": "packages/sdk-node"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist",
    "check-types": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "dependencies": {
    "@mindfiredigital/sdk-core": "workspace:*"
  },
  "devDependencies": {
    "@mindfiredigital/types": "workspace:*",
    "@mindfiredigital/eslint-config": "workspace:*",
    "@mindfiredigital/typescript-config": "workspace:*",
    "@types/node": "^20.11.0",
    "tsup": "^8.0.2",
    "typescript": "^5.3.3",
    "vitest": "^2.1.9"
  }
}
