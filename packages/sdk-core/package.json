{
  "name": "@mindfiredigital/sdk-core",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "author": "Mindfire Digital",
  "repository": {
    "type": "git",
    "url": "https://github.com/mindfiredigital/agentic-headless-cms.git",
    "directory": "packages/sdk-core"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "check-types": "tsc --noEmit"
  },
  "devDependencies": {
    "@mindfiredigital/types": "workspace:*",
    "@mindfiredigital/typescript-config": "workspace:*",
    "@types/node": "^24.0.0",
    "tsup": "^8.3.5",
    "typescript": "5.9.2",
    "vitest": "^2.1.8"
  }
}
