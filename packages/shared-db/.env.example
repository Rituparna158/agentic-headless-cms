DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agentic_cms

# drizzle-kit reads DATABASE_URL from the environment (see drizzle.config.ts)
# - to run migrations against the E2E test database instead, override it on
# the command line rather than changing this file, e.g.:
#   DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agentic_cms_test pnpm db:migrate
# See docs/testing.md.
