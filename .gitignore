# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Dependencies
node_modules
.pnp
.pnp.js

# Local env files — catch every variant (.env, .env.local, .env.production,
# .env.production.local, etc.) at any depth, but always allow the checked-in
# example files back in.
.env*
!.env.example

# Testing
coverage

# Turbo
.turbo

# Vercel
.vercel

# Build Outputs
.next/
out/
build
dist
*.tsbuildinfo

# Local media storage (STORAGE_ADAPTER=local) — uploaded files, never source
apps/backend/uploads/


# Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Misc
.DS_Store
*.pem


#test results
/test-results/
uploads