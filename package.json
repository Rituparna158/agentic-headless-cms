{
  "name": "agentic-headless-cms",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "build:analyze": "pnpm --filter cms-ui run build:analyze",
    "analyze": "pnpm --filter cms-ui run build:analyze",
    "dev": "turbo run dev",
    "cli": "pnpm --filter backend run cli",
    "cli:ui": "pnpm --filter backend run cli serve-ui",
    "db:migrate": "pnpm --filter @repo/shared-db run db:migrate",
    "db:push": "pnpm --filter @repo/shared-db run db:push",
    "db:backup": "node scripts/db-backup.mjs",
    "seed:admin": "pnpm --filter @repo/shared-db run seed:admin",
    "seed:system-schemas": "pnpm --filter @repo/shared-db run seed:system-schemas",
    "codegen": "node ./packages/sdk-codegen/dist/cli.js --url http://localhost:3000 --output ./apps/frontend/types.ts",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "test": "turbo run test --concurrency=1",
    "test:coverage": "pnpm -r run test -- --coverage",
    "prepare": "husky",
    "changeset": "changeset",
    "changeset:autogenerate": "node .github/changeset-autogenerate.mjs",
    "version-packages": "node .github/changeset-version.mjs",
    "release": "changeset publish"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.5.1",
    "@changesets/cli": "^2.29.0",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@repo/eslint-config": "workspace:*",
    "@vitest/coverage-v8": "4.1.10",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "prettier": "^3.7.4",
    "ts-morph": "^28.0.0",
    "turbo": "^2.10.4",
    "typescript": "5.9.2",
    "vitest": "4.1.10"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=20.9.0"
  },
  "pnpm": {
    "overrides": {
      "react": "19.2.0",
      "react-dom": "19.2.0"
    }
  }
}
