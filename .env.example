# ==========================================
# Agentic Headless CMS — Unified Env Config
# ==========================================

# --- Backend & Worker Config ---
PORT=3000
NODE_ENV=development
DB_CLIENT=postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agentic_cms
DATABASE_POOL_MAX=10
DATABASE_SSL=false

# Testing database for e2e
E2E_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agentic_cms_test

CORS_ORIGIN=http://localhost:3001
LOG_LEVEL=info

JWT_SECRET=super_secret_jwt_key_at_least_32_characters_long
JWT_EXPIRES_IN=1d

# Used by the seed-admin script to provision the initial superadmin
SEED_ADMIN_EMAIL=admin@agentic-cms.com
SEED_ADMIN_PASSWORD=admin

# Used by the seed-admin script to provision the CMS UI admin
SEED_CMS_ADMIN_EMAIL=cms-admin@agentic-cms.com
SEED_CMS_ADMIN_PASSWORD=admin

STORAGE_ADAPTER=local
STORAGE_LOCAL_UPLOAD_DIR=./uploads
STORAGE_LOCAL_BASE_URL=/api/v1/media/file
MAX_UPLOAD_SIZE_BYTES=10485760

# Required only when STORAGE_ADAPTER=s3
STORAGE_S3_BUCKET=
STORAGE_S3_REGION=
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=
# Optional: for S3-compatible providers (MinIO, R2, localstack)
STORAGE_S3_ENDPOINT=
STORAGE_S3_FORCE_PATH_STYLE=false
STORAGE_S3_PUBLIC_URL_BASE=

REDIS_URL=redis://localhost:6379
QUEUE_JOB_ATTEMPTS="3"
QUEUE_JOB_BACKOFF_DELAY_MS="5000"

# OIDC / SSO Integration (Optional)
OIDC_ISSUER_URL="https://accounts.google.com"
OIDC_CLIENT_ID="your_oidc_client_id"
OIDC_CLIENT_SECRET="your_oidc_client_secret"
OIDC_REDIRECT_URI="http://localhost:3000/api/v1/auth/sso/callback"

# Email settings for invitations
APP_URL=http://localhost:3001
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Agentic CMS" <noreply@agentic-cms.com>

# --- Frontend Config ---
# API URL
NEXT_PUBLIC_API_URL="http://localhost:3000"

# OIDC / SSO Integration (Required on backend, added here for reference)
OIDC_ISSUER_URL="https://accounts.google.com"
OIDC_CLIENT_ID="your_oidc_client_id"
OIDC_CLIENT_SECRET="your_oidc_client_secret"
OIDC_REDIRECT_URI="http://localhost:3000/api/v1/auth/sso/callback"
API_INTERNAL_URL=http://localhost:3000

# OIDC/SSO
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:3000/api/v1/auth/sso/callback
OIDC_DEFAULT_ROLE_ID=

# OIDC/SSO
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:3000/api/v1/auth/sso/callback
OIDC_DEFAULT_ROLE_ID=

CMS_API_TOKEN=
